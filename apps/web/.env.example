# API del dev server de Persona 1, accesible por Tailscale.
# OJO: `localhost:8080` NO sirve ni en la laptop de Persona 1. uvicorn escucha
# sólo en la IP de Tailscale (comprobado el 23-sep con `ss -tln`), así que
# cambiar esto por localhost deja todas las pantallas vacías.
VITE_API_BASE_URL=http://localhost:8080
