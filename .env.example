# ADUANERO OS — plantilla de entorno. Cópiala a .env y rellena las contraseñas.
# Sólo .env.example se versiona (§40 maestro). Los campos de secreto van VACÍOS.

APP_ENV=local
LOG_FORMAT=console
LOG_LEVEL=INFO

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=

# ── PostgreSQL (puerto 5433, no 5432) ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aduanero
POSTGRES_USER=aduanero_app
POSTGRES_PASSWORD=
TEAM_BIND_ADDR=127.0.0.2

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=aduanero_minio
MINIO_ROOT_PASSWORD=
MINIO_SECURE=false

# ── Proveedores de IA (§29: el dominio nunca importa un SDK concreto) ────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
