# ─────────────────────────────────────────────────────────────────────────────
# ADUANERO OS — plantilla de configuración
# Copia a .env y rellena.  .env NUNCA se versiona (§40 maestro / §10.10 P1).
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=aduanero-os
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | console

# ── API ──────────────────────────────────────────────────────────────────────
# 8000 lo ocupa otro proyecto en la laptop de Persona 1 -> usamos 8080.
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# ── Bind de servicios (§3 / §41: NUNCA exponer a Internet) ───────────────────
# Cada puerto se publica dos veces: en 127.0.0.1 (fijo, siempre) y aquí.
#
# 100.x.y.z  -> IP Tailscale de Persona 1: así conectan Persona 2 y 3.
#               La obtienes con `tailscale ip -4`.
# 127.0.0.2  -> valor por defecto. Loopback, no expone nada; úsalo si levantas
#               el stack sin Tailscale.
# 0.0.0.0    -> PROHIBIDO. Expone a toda la LAN y, con IPv6 público, a Internet.
TEAM_BIND_ADDR=127.0.0.2

# ── PostgreSQL + pgvector ────────────────────────────────────────────────────
# 5432 lo ocupa el PostgreSQL nativo de la laptop -> el contenedor publica 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aduanero
POSTGRES_USER=aduanero_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://aduanero_app:CAMBIAME@localhost:5433/aduanero

# ── Neo4j (Knowledge Graph) ──────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:CAMBIAME@localhost:6379/0

# ── MinIO (documentos: PDFs DOF, fichas técnicas, imágenes) ──────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=aduanero_minio
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_RAW=aduanero-raw
MINIO_BUCKET_DOCS=aduanero-docs
MINIO_SECURE=false

# ── Proveedores de IA (§29 maestro: nunca acoplar dominio a un proveedor) ────
# Vacío = ese proveedor queda deshabilitado. No commitear llaves.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
